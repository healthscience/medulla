}export function buildDbKey(device, timestamp = Date.now()) {
  return `conduction/${device}/${timestamp}`
}

export function parsePacket(raw) {
  const packet = JSON.parse(raw)
  const { device, action, payload, cipher } = packet
  return { device, action, payload, cipher }
}

export function commitResponse(key, device) {
  return { type: 'INGRESS_COMMITTED', key, device, status: 'OK' }
}

// Acknowledgement sent back to an egressing host/device after a ledger read.
export function egressResponse(device, records, cursor = null) {
  return { type: 'EGRESS_TELEMETRY', device, records, cursor, status: 'OK' }
}
// src/medulla-core.mjs
// Host-agnostic conduction core: identity, append-only ledger, ingress/egress.
// Pure Node — no `bare`, no React Native. Runs in a bare worklet *or* under plain
// `node` for unit tests.
import Corestore from 'corestore'
import Hyperbee from 'hyperbee'
import b4a from 'b4a'
import sodium from 'sodium-native'
import { buildDbKey, parsePacket, commitResponse } from './ingress.mjs'

export const PROTOCOL = 'conduction/medulla/v1'
export const INGRESS_TELEMETRY = 'INGRESS_TELEMETRY'
export const EGRESS_TELEMETRY = 'EGRESS_TELEMETRY'
export const MEDULLA_READY = 'MEDULLA_READY'
export const MEDULLA_ERROR = 'MEDULLA_ERROR'
export const INGRESS_COMMITTED = 'INGRESS_COMMITTED'

const KEY_BYTES = 32
const IDENTITY_KEY = 'identity'
const IDENTITY_STORE = 'medulla-identity'
const LEDGER_STORE = 'medulla-conduction-index'

export class Medulla {
  constructor(storageDir, opts = {}) {
    this.storageDir = storageDir
    this.store = new Corestore(storageDir)
    this.bee = null
    this.identity = null // { publicKey, secretKey } as Buffers
    this.opts = opts
  }

  async ready() {
    await this.store.ready()
    this.identity = await this._loadOrCreateIdentity()
    this.bee = new Hyperbee(this.store.get({ name: LEDGER_STORE }), {
      keyEncoding: 'utf-8',
      valueEncoding: 'json'
    })
    await this.bee.ready()
  }

  async _loadOrCreateIdentity() {
    const idBee = new Hyperbee(this.store.get({ name: IDENTITY_STORE }), {
      keyEncoding: 'utf-8',
      valueEncoding: 'json'
    })
    await idBee.ready()
    let rec = await idBee.get(IDENTITY_KEY)
    if (!rec || !rec.value || !rec.value.publicKey || !rec.value.secretKey) {
      const pk = b4a.alloc(KEY_BYTES)
      const sk = b4a.alloc(KEY_BYTES)
      sodium.crypto_box_keypair(pk, sk)
      await idBee.put(IDENTITY_KEY, {
        publicKey: b4a.toHex(pk),
        secretKey: b4a.toHex(sk),
        createdAt: Date.now()
      })
      rec = await idBee.get(IDENTITY_KEY)
    }
    return {
      publicKey: b4a.from(rec.value.publicKey, 'hex'),
      secretKey: b4a.from(rec.value.secretKey, 'hex')
    }
  }

  get publicKey() {
    return this.identity ? this.identity.publicKey : null
  }

  get publicKeyHex() {
    return this.identity ? b4a.toHex(this.identity.publicKey) : null
  }

  // Persist one ingress telemetry packet for a device.
  async ingest(device, payload, cipher = 'heli-phase-active', timestamp = Date.now()) {
    if (!this.bee) throw new Error('Medulla not ready — call ready() first')
    const key = buildDbKey(device, timestamp)
    await this.bee.put(key, {
      device,
      payload,
      cipher,
      recordedAt: timestamp
    })
    return commitResponse(key, device)
  }

  // Read back committed ingress records for a device, newest-first.
  async query(device, limit = 100) {
    if (!this.bee) throw new Error('Medulla not ready — call ready() first')
    const results = []
    const stream = this.bee.createReadStream({
      gt: `conduction/${device}/`,
      lte: `conduction/${device}/\uFFFF`,
      reverse: true,
      limit
    })
    for await (const entry of stream) results.push(entry)
    return results
  }

  async close() {
    if (this.store) await this.store.close()
  }
}

// Re-export protocol helpers so host shells and worklets share one import path.
export { buildDbKey, parsePacket, commitResponse } from './ingress.mjs'