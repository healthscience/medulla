    rem += state.buffer[state.start++] * Math.pow(2, 8 * i)
  }

  return rem * Math.pow(2, exp - 11) + max
}

function validateLexint(num) {
  if (num >= 0 && num <= Number.MAX_VALUE) return num // Handles NaN as well

  throw outsideLexintRange()
}

function outsideLexintRange() {
  return new RangeError(`lexint must be between 0 and ${Number.MAX_VALUE}`)
}
{
  "name": "compact-encoding",
  "version": "3.6.0",
  "description": "A series of compact encoding schemes for building small and fast parsers and serializers",
  "exports": {
    "./package": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./endian": {
      "types": "./endian.d.ts",
      "default": "./endian.js"
    },
    "./lexint": {
      "types": "./lexint.d.ts",
      "default": "./lexint.js"
    },
    "./raw": {
      "types": "./raw.d.ts",
      "default": "./raw.js"
    }
  },
  "files": [
    "endian.js",
    "endian.d.ts",
    "index.js",
    "index.d.ts",
    "lexint.js",
    "lexint.d.ts",
    "raw.js",
    "raw.d.ts"
  ],
  "scripts": {
    "format": "prettier --write . && lunte --fix",
    "lint": "prettier --check . && lunte",
    "test": "npm run test:bare && npm run test:node",
    "test:bare": "brittle-bare --coverage test.js",
    "test:node": "brittle-node --coverage test.js"
  },
  "repository": {
    "type": "git",
